# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:CONTRASEÑA@localhost:5432/guia_digital

# Google OAuth — obtener en https://console.cloud.google.com/
# (Credenciales > Crear credenciales > ID de cliente OAuth 2.0)
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET

# JWT — clave secreta para firmar los tokens de sesión
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERA_UNA_CLAVE_ALEATORIA_LARGA_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chatbot — LLM gratuito via Groq (https://console.groq.com/)
# Si no se usa chatbot, dejar vacío o comentar la línea
GROQ_API_KEY=TU_GROQ_API_KEY

# CORS — orígenes permitidos en producción (separados por comas)
# En local no es necesario; en producción poner la URL pública del frontend.
# Debe coincidir exactamente con AUTH_URL del frontend (https, sin barra final).
# ALLOWED_ORIGINS=https://guiadigital.ejemplo.cl

# Entorno — controla si /docs y /redoc están habilitados
# En local: development | En producción: omitir o poner production
ENVIRONMENT=development
