# Variables del frontend Next.js.
#
# Copiar a ".env.local" para desarrollo local, o a ".env" en el servidor de
# producción (docker-compose.prod.yml lee ./frontend/.env).
#
# ATENCIÓN — hay dos tipos de variable y se comportan distinto:
#
#   · NEXT_PUBLIC_*  se hornean DURANTE EL BUILD. Cambiarlas exige recompilar
#                    la imagen; reiniciar el contenedor no sirve de nada.
#   · Las demás      se leen en TIEMPO DE EJECUCIÓN, desde este archivo.

# ── Se hornea en el build ────────────────────────────────────────────────────
# URL del backend FastAPI, tal como la ve el NAVEGADOR del usuario final
# (no el nombre interno del servicio de Docker).
# En local: http://localhost:8000/api
# En producción: URL pública, ej. https://guiadigital.ejemplo.cl/api
#
# Con Docker esta variable NO se toma de aquí: se pasa como build arg desde
# el compose. En docker-compose.prod.yml se lee del .env de la raíz del repo.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ── Se leen en tiempo de ejecución ───────────────────────────────────────────

# URL del backend para las llamadas que hace el SERVIDOR de Next.js (NextAuth
# valida contra el backend el token de Google al iniciar sesión). No la usa el
# navegador. Con Docker la define el compose y apunta al nombre del servicio:
#   BACKEND_INTERNAL_URL=http://backend:7860/api
# Fuera de Docker no hace falta definirla: se usa NEXT_PUBLIC_API_URL.

# NextAuth — mismo Client ID y Secret que el backend (Google OAuth)
# Obtener en https://console.cloud.google.com/
AUTH_GOOGLE_ID=TU_CLIENT_ID.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=TU_CLIENT_SECRET

# NextAuth — clave secreta para firmar las cookies de sesión
# Generar con: openssl rand -hex 32
AUTH_SECRET=GENERA_UNA_CLAVE_ALEATORIA_AQUI

# URL pública del frontend (usada por NextAuth para los redirects)
# En local: http://localhost:3000
# En producción: https://guiadigital.ejemplo.cl (https, sin barra final)
AUTH_URL=http://localhost:3000
