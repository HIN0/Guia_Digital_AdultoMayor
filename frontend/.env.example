# URL del backend FastAPI
# En local: http://localhost:8000/api
# En producción: URL de tu HF Space, ej. https://user-repo.hf.space/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# NextAuth — mismo Client ID y Secret que el backend (Google OAuth)
# Obtener en https://console.cloud.google.com/
AUTH_GOOGLE_ID=TU_CLIENT_ID.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=TU_CLIENT_SECRET

# NextAuth — clave secreta para firmar las cookies de sesión
# Generar con: openssl rand -hex 32
AUTH_SECRET=GENERA_UNA_CLAVE_ALEATORIA_AQUI

# URL pública del frontend (usada por NextAuth para los redirects)
# En local: http://localhost:3000
# En producción: https://tu-app.vercel.app
AUTH_URL=http://localhost:3000
