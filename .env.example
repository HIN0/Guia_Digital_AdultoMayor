# Variables de la base de datos para docker-compose.
# Copiar este archivo a ".env" en la raíz del repo y completar los valores.
#
# Las credenciales de la aplicación (Google OAuth, SECRET_KEY, Groq) NO van aquí:
# van en backend/.env — ver backend/.env.example.

# Desarrollo local (docker-compose.yml): si no defines nada, se usa la
# contraseña por defecto 54321. Sirve solo para desarrollo.
POSTGRES_PASSWORD=54321

# Producción (docker-compose.prod.yml): estas tres son obligatorias y el
# arranque falla si faltan. Usar una contraseña fuerte y distinta a la de arriba.
POSTGRES_USER=guia_digital
# POSTGRES_PASSWORD=<contraseña fuerte, no reutilizar la de desarrollo>
POSTGRES_DB=guia_digital

# Recordatorio: en producción, DATABASE_URL dentro de backend/.env debe apuntar
# al host "db" (nombre del servicio de Docker), no a localhost:
#   DATABASE_URL=postgresql://guia_digital:<contraseña>@db:5432/guia_digital

# ── Frontend (docker-compose.prod.yml) ──────────────────────────────────────
# URL pública del backend, tal como la ve el navegador del usuario final.
# Se hornea dentro del build de Next.js, por eso vive aquí y no en
# frontend/.env: el compose la pasa como build arg al construir la imagen.
# Si cambia el dominio hay que reconstruir el frontend:
#   docker compose -f docker-compose.prod.yml up -d --build frontend
NEXT_PUBLIC_API_URL=https://guiadigital.ejemplo.cl/api
